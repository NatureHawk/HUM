# Copy to `.env` and adjust if the defaults collide with something local.
# docker-compose.yml and the backend both read this file. See docs/deployment.md
# for the full explanation of every variable below and how they behave in production.

# ============================================================================
# LOCAL DEVELOPMENT — these values work out of the box against
# `docker compose up -d --wait`. Nothing here is a secret; it is only ever
# read on your own machine.
# ============================================================================

# Credentials for the local Postgres container. Non-default only because they
# have to be *something* — this database is never reachable from outside your
# machine.
POSTGRES_USER=syncboard
POSTGRES_PASSWORD=syncboard
POSTGRES_DB=syncboard

# Host ports for Postgres and Redis. Deliberately non-default (5434 / 6380) so
# this stack can run alongside another project already holding 5432 / 6379.
POSTGRES_PORT=5434
REDIS_PORT=6380

# postgresql+psycopg:// is psycopg 3. SQLAlchemy picks the sync or the async
# flavour from the engine constructor, so this one URL serves both the async
# application engine and the sync engine Alembic uses.
DATABASE_URL=postgresql+psycopg://syncboard:syncboard@localhost:5434/syncboard

# Separate database used only by the backend test suite. Tests create and drop
# it themselves; never point this at the development database.
TEST_DATABASE_URL=postgresql+psycopg://syncboard:syncboard@localhost:5434/syncboard_test

# Managed Redis in production is usually `rediss://` (TLS); both schemes work
# unchanged. Locally there is no TLS, hence plain `redis://`.
REDIS_URL=redis://localhost:6380/0

# development or production. Gates the startup checks below and the session
# cookie's SameSite/Secure flags (backend/app/core/session.py). Locally this
# should stay "development" — leave it unset, since that is the default.
ENVIRONMENT=development

# The app's environment is "development" by default, so FRONTEND_URL is not
# required locally: app/core/config.py adds http://localhost:3001 and
# http://127.0.0.1:3001 to the allowed CORS origins automatically outside
# production. CORS_ORIGINS below is kept explicit anyway so the local list is
# visible without reading the source.
CORS_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001"]

# Logs every SQL statement. Useful while debugging a query locally; leave off
# by default because it is noisy.
SQL_ECHO=false

# Abuse ceilings for a public demo with no auth. The defaults below match the
# application's built-in defaults (app/core/config.py) — set explicitly here
# only so they are visible; omitting them entirely would behave identically.
MAX_NOTES_PER_BOARD=500
MAX_REQUEST_BYTES=65536

# ============================================================================
# PRODUCTION — set these on the platform (Render, Railway, Fly, ...), not in
# a committed .env file. Shapes only below; never paste a real secret here.
# ============================================================================

# ENVIRONMENT=production
#
# Required in production. get_settings() (backend/app/core/config.py) refuses
# to start without a real DATABASE_URL / SESSION_SECRET / allowed origin — see
# docs/deployment.md section 3.

# DATABASE_URL=postgres://user:password@host:5432/dbname
# Managed providers (Render, Railway, Neon) hand out postgres:// or
# postgresql://; a validator rewrites either to postgresql+psycopg:// for you,
# so the value can be pasted in unchanged.

# REDIS_URL=rediss://default:password@host:6379
# TLS scheme, straight from the provider's dashboard.

# SESSION_SECRET=
# Signs the guest session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be stable across restarts and identical on every replica, or guests are
# logged out and replicas disagree about who anyone is. The backend WILL NOT
# START in production without this set.

# FRONTEND_URL=https://syncboard.vercel.app
# The deployed frontend's origin. Required in production (or CORS_ORIGINS
# below) so the browser's CORS preflight — and the credentialed session
# cookie — have somewhere to be allowed from. Never "*": a cookie sent with
# credentials cannot be paired with a wildcard origin.

# CORS_ORIGINS=https://preview-123.vercel.app,https://staging.example.com
# Optional extra origins, comma-separated (a JSON array also works). For
# preview deployments or a second domain, in addition to FRONTEND_URL.

# PORT=
# Injected by the platform. entrypoint.sh reads it and binds uvicorn to it;
# do not set this yourself.

# WEB_CONCURRENCY=2
# Number of uvicorn worker processes. Safe to raise above 1 specifically
# because Redis bridges workers for the WebSocket fan-out — see
# backend/tests/test_hub.py and docs/deployment.md section 6.

# SQL_ECHO=false
# Leave off in production; it is noisy and adds a little overhead per query.
